#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_nonuniform_qualifier : require
#define ENTITY 1
#include "/lib/geometry.glsl"
#include "/lib/coverage.glsl"
#include "/lib/visibility.glsl"
void main() {
    uvec3 v=triangleVertices();
    uint flags=entityFlags(v.x);
    if(!entityVisibleToRay(flags,hit.visibilityFlags)) ignoreIntersectionEXT;
    else if(!visibleTriangleSide(twoSidedSurface(),gl_HitKindEXT==gl_HitKindBackFacingTriangleEXT,hit.visibilityFlags))
        ignoreIntersectionEXT;
    else {
        float alpha=sampleSurface().a;
        if(alphaBlendSurface()) {
            if(!covered(alpha,hit.coverageSeed,uint(gl_PrimitiveID),uint(gl_InstanceID))) ignoreIntersectionEXT;
        } else if(alphaDiscardSurface()&&alpha<0.5) ignoreIntersectionEXT;
    }
}
