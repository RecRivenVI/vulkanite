#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_nonuniform_qualifier : require
#define ENTITY 1
#include "/lib/geometry.glsl"
#include "/lib/coverage.glsl"
#include "/lib/visibility.glsl"
void main() {
    uint flags=word(triangleVertices().x,11u);
    if(!visibleToRay(flags,hit.cameraRay)) {
        // View models are visible only to the player's camera, never world shadows/reflections.
        ignoreIntersectionEXT;
    } else if(!dielectric(flags>>16u)) {
        float alpha=sampleSurface().a;
        if((flags&8u)!=0u) {
            // Unbiased thin coverage for camera, indirect and shadow rays alike.
            if(!covered(alpha,hit.coverageSeed,uint(gl_PrimitiveID),uint(gl_InstanceID))) ignoreIntersectionEXT;
        } else if(alpha<0.5) ignoreIntersectionEXT;
    }
}
