#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_control_flow_attributes : require
#include "/lib/ray.glsl"
#define VIEW_MODE 0 // [0 1 2 3 4]
#define SAMPLES_PER_PIXEL 4 // [1 2 4 8]
#define MAX_BOUNCES 8 // [4 6 8 12]
#define RECONSTRUCTION_MODE 2 // [0 1 2]
#define RECONSTRUCTION_QUALITY 2 // [0 1 2 3 5]
#define SHARC_ENABLED 1 // [0 1]
#define SHARC_CAPACITY_POWER 20 // [18 19 20 21 22]
#define SHARC_UPDATE_PERIOD 16 // [8 16 25 32]
// Host-executed reconstruction request. 0=raw fallback, 1=SR, 2=RR.
const int vulkaniteReconstructionVersion = 2;
#if VIEW_MODE == 0
const int vulkaniteReconstructionMode = RECONSTRUCTION_MODE;
#else
const int vulkaniteReconstructionMode = 0;
#endif
// NGX quality: 0=performance, 1=balanced, 2=quality, 3=ultra-performance, 4=ultra-quality, 5=DLAA.
const int vulkaniteReconstructionQuality = RECONSTRUCTION_QUALITY;
const int vulkaniteReconstructionOutput = 0;
const int vulkaniteReconstructionExposure = 8;
const int vulkaniteSharcVersion = 1;
const int vulkaniteSharcEnabled = SHARC_ENABLED;
const int vulkaniteSharcCapacityPower = SHARC_CAPACITY_POWER;
#include "/lib/sharc.glsl"
#include "/lib/atmosphere.glsl"
uint rng;
vec3 moonDirection;
float lunarScale;
float randomFloat() {
    rng=rng*747796405u+2891336453u;
    uint x=((rng>>((rng>>28u)+4u))^rng)*277803737u;
    return uintBitsToFloat(0x3f800000u|(((x>>22u)^x)>>9u))-1.0;
}
vec3 basisDirection(vec3 axis,float cosine,float angle) {
    vec3 tangent=normalize(cross(abs(axis.y)<0.99?vec3(0,1,0):vec3(1,0,0),axis));
    float sine=sqrt(max(0.0,1.0-cosine*cosine));
    return normalize(axis*cosine+(tangent*cos(angle)+cross(axis,tangent)*sin(angle))*sine);
}
vec3 cosineHemisphere(vec3 n) { return basisDirection(n,sqrt(randomFloat()),2.0*PI*randomFloat()); }
void traceVisibility(vec3 origin,vec3 direction,float distance,uint visibility) {
    hit.distance=-1.0;
    hit.cameraRay=visibility;
    randomFloat();
    hit.coverageSeed=rng;
    traceRayEXT(scene,0u,255,0,0,0,origin,0.001,direction,distance,0);
}
void trace(vec3 origin,vec3 direction,float distance) { traceVisibility(origin,direction,distance,0u); }
vec3 offsetOrigin(Surface s,vec3 direction) {
    return s.position+s.normal*(dot(s.normal,direction)>=0.0?0.002:-0.002);
}
float powerWeight(float a,float b) { return a*a/max(a*a+b*b,1e-30); }
vec3 directSun(Surface s,vec3 sunDirection) {
    // Sample both finite emitters with a power-weighted mixture.
    float sunPower=max(dot(solarTransmission(planetPosition(s.position.y),sunDirection),vec3(0.2126,0.7152,0.0722)),0.0);
    float moonPower=lunarScale*max(dot(solarTransmission(planetPosition(s.position.y),moonDirection),vec3(0.2126,0.7152,0.0722)),0.0);
    if(sunPower+moonPower<=0.0) return vec3(0.0);
    float probabilitySun=sunPower/(sunPower+moonPower);
    bool sampleSun=randomFloat()<probabilitySun;
    vec3 axis=sampleSun?sunDirection:moonDirection;
    float selection=sampleSun?probabilitySun:1.0-probabilitySun;
    vec3 l=basisDirection(axis,mix(SUN_COS,1.0,randomFloat()),2.0*PI*randomFloat());
    float cosine=max(dot(s.normal,l),0.0);
    if(cosine==0.0) return vec3(0.0);
    trace(offsetOrigin(s,l),l,65536.0);
    // Specular boundaries cannot be traversed as straight alpha shadows. Caustic paths
    // are sampled by the BSDF path below, rather than inventing transparent shadows.
    if(hit.distance>=0.0) return vec3(0.0);
    float lightPdf=selection/SUN_OMEGA, bsdfPdf=cosine/PI;
    return s.color.rgb/PI*sunRadiance(l,axis,s.position.y)*(sampleSun?1.0:lunarScale)*cosine/lightPdf*powerWeight(lightPdf,bsdfPdf);
}
vec3 pathTrace(vec3 origin,vec3 direction,vec3 sunDirection) {
    vec3 throughput=vec3(1.0), radiance=vec3(0.0);
    uint media[14]; int mediumDepth=0;
    bool viewModelMedium[14]; viewModelMedium[0]=false;
    media[0]=(camera.flags&3u)==1u?WATER:0u;
    float previousPdf=0.0, etaScale=1.0;
    bool previousDelta=true;
    for(int bounce=0;bounce<MAX_BOUNCES;bounce++) {
        // Camera-only glass still needs its exit boundary, but cannot enter world shadow/reflection rays.
        traceVisibility(origin,direction,65536.0,bounce==0?1u:(viewModelMedium[mediumDepth]?2u:0u));
        Surface surface=hit;
        if(surface.distance<0.0) {
            // Missing geometry is not an exit interface for an absorbing volume.
            if(media[mediumDepth]==WATER) break;
            float sunPower=max(dot(solarTransmission(planetPosition(origin.y),sunDirection),vec3(0.2126,0.7152,0.0722)),0.0);
            float moonPower=lunarScale*max(dot(solarTransmission(planetPosition(origin.y),moonDirection),vec3(0.2126,0.7152,0.0722)),0.0);
            float probabilitySun=sunPower/max(sunPower+moonPower,1e-30);
            float sunWeight=previousDelta?1.0:powerWeight(previousPdf,probabilitySun/SUN_OMEGA);
            float moonWeight=previousDelta?1.0:powerWeight(previousPdf,(1.0-probabilitySun)/SUN_OMEGA);
            vec3 environment=skyRadiance(direction,sunDirection,origin.y)+sunRadiance(direction,sunDirection,origin.y)*sunWeight+stellarRadiance(direction,origin.y);
            if(lunarScale>0.0) environment+=lunarScale*(skyRadiance(direction,moonDirection,origin.y)+sunRadiance(direction,moonDirection,origin.y)*moonWeight);
            radiance+=throughput*environment;
            break;
        }
        throughput*=exp(-absorption(media[mediumDepth])*surface.distance);
        if(SHARC_ENABLED==1 && camera.sharcConfig.z!=0u && bounce>0 && !dielectric(surface.material)) {
            SharcParameters sharc=vulkaniteSharcParameters();
            uint level=HashGridGetLevel(surface.position,sharc.hashGridParameters);
            float voxelSize=HashGridGetVoxelSize(level,sharc.hashGridParameters);
            vec3 cachedRadiance;
            if(surface.distance>=voxelSize && SharcGetCachedRadiance(sharc,vulkaniteSharcHit(surface),cachedRadiance,true)) {
                radiance+=throughput*cachedRadiance;
                break;
            }
        }
        radiance+=throughput*emission(surface.material,surface.color.rgb);
        if(dielectric(surface.material)) {
            bool exiting=media[mediumDepth]==surface.material;
            uint nextMedium=exiting?(mediumDepth>0?media[mediumDepth-1]:0u):surface.material;
            float etaI=ior(media[mediumDepth]), etaT=ior(nextMedium);
            float eta=etaI/etaT;
            float reflectance=fresnelDielectric(clamp(-dot(direction,surface.normal),0.0,1.0),etaI,etaT);
            if(randomFloat()<reflectance) direction=reflect(direction,surface.normal);
            else {
                direction=normalize(refract(direction,surface.normal,eta));
                // Radiance transport requires eta^2. Remove it only in roulette's survival estimate.
                throughput*=eta*eta; etaScale/=eta*eta;
                if(exiting) { if(mediumDepth>0) mediumDepth--; else { media[0]=0u; viewModelMedium[0]=false; } }
                else { mediumDepth++; media[mediumDepth]=nextMedium; viewModelMedium[mediumDepth]=(surface.kind&4u)!=0u; }
            }
            previousDelta=true;
        } else {
            if(media[mediumDepth]==0u) radiance+=throughput*directSun(surface,sunDirection);
            throughput*=clamp(surface.color.rgb,vec3(0.0),vec3(1.0));
            direction=cosineHemisphere(surface.normal);
            previousPdf=max(dot(surface.normal,direction),0.0)/PI;
            previousDelta=false;
        }
        if(bounce>=3) {
            vec3 survivalWeight=throughput*etaScale;
            float survival=clamp(max(survivalWeight.r,max(survivalWeight.g,survivalWeight.b)),0.05,0.95);
            if(randomFloat()>=survival) break;
            throughput/=survival;
        }
        origin=offsetOrigin(surface,direction);
    }
    return radiance;
}

// Sparse cache population. It is logically the SHaRC Update pass, co-scheduled
// with the query dispatch so Resolve can run once after this RT invocation.
void updateSharc(vec3 origin,vec3 direction,vec3 sunDirection) {
    if(SHARC_ENABLED==0 || camera.sharcConfig.z==0u) return;
    SharcParameters sharc=vulkaniteSharcParameters();
    SharcState state; SharcInit(state);
    uint media[14]; int mediumDepth=0;
    media[0]=(camera.flags&3u)==1u?WATER:0u;
    for(int bounce=0;bounce<MAX_BOUNCES;bounce++) {
        trace(origin,direction,65536.0);
        Surface surface=hit;
        if(surface.distance<0.0) {
            if(media[mediumDepth]==WATER) return;
            vec3 environment=skyRadiance(direction,sunDirection,origin.y)+sunRadiance(direction,sunDirection,origin.y)+stellarRadiance(direction,origin.y);
            if(lunarScale>0.0) environment+=lunarScale*(skyRadiance(direction,moonDirection,origin.y)+sunRadiance(direction,moonDirection,origin.y));
            SharcUpdateMiss(sharc,state,environment);
            return;
        }
        vec3 segmentWeight=exp(-absorption(media[mediumDepth])*surface.distance);
        if(dielectric(surface.material)) {
            bool exiting=media[mediumDepth]==surface.material;
            uint nextMedium=exiting?(mediumDepth>0?media[mediumDepth-1]:0u):surface.material;
            float etaI=ior(media[mediumDepth]),etaT=ior(nextMedium),eta=etaI/etaT;
            float reflectance=fresnelDielectric(clamp(-dot(direction,surface.normal),0.0,1.0),etaI,etaT);
            if(randomFloat()<reflectance) direction=reflect(direction,surface.normal);
            else {
                direction=normalize(refract(direction,surface.normal,eta));
                segmentWeight*=eta*eta;
                if(exiting) { if(mediumDepth>0) mediumDepth--; else media[0]=0u; }
                else { mediumDepth++; media[mediumDepth]=nextMedium; }
            }
        } else {
            vec3 direct=emission(surface.material,surface.color.rgb);
            if(media[mediumDepth]==0u) direct+=directSun(surface,sunDirection);
            if(!SharcUpdateHit(sharc,state,vulkaniteSharcHit(surface),direct,randomFloat())) return;
            segmentWeight*=clamp(surface.color.rgb,vec3(0.0),vec3(1.0));
            direction=cosineHemisphere(surface.normal);
        }
        SharcSetThroughput(state,segmentWeight);
        origin=offsetOrigin(surface,direction);
    }
}
void main() {
    ivec2 pixel=ivec2(gl_LaunchIDEXT.xy);
    vec2 p=(vec2(pixel)+0.5+camera.jitterAndRenderSize.xy)/vec2(gl_LaunchSizeEXT.xy);
    vec3 d=mix(mix(camera.corners[0],camera.corners[2],p.y),mix(camera.corners[1],camera.corners[3],p.y),p.x);
    d=normalize(mat3(camera.inverseView)*d);
    vec3 sunDirection=normalize(mat3(camera.inverseView)*camera.sun.xyz);
    moonDirection=normalize(mat3(camera.inverseView)*camera.moon.xyz);
    lunarScale=2.5e-6*clamp(camera.moon.w,0.0,1.0);
    rng=uint(gl_LaunchIDEXT.x)*1973u+uint(gl_LaunchIDEXT.y)*9277u+camera.frame*26699u+911u;
    if(SHARC_ENABLED==1 && camera.sharcConfig.z!=0u && (rng%uint(SHARC_UPDATE_PERIOD))==camera.sharcConfig.y%uint(SHARC_UPDATE_PERIOD))
        updateSharc(camera.inverseView[3].xyz,d,sunDirection);
    traceVisibility(camera.inverseView[3].xyz,d,65536.0,1u);
    Surface primary=hit;
    vec4 currentClip, previousClip;
    float depth=0.0, bias=0.0, roughness=1.0, specularDistance=0.0;
    vec3 albedo=vec3(0.0), specularAlbedo=vec3(0.0), normal=vec3(0.0,1.0,0.0);
    if(primary.distance>=0.0) {
        currentClip=camera.viewProjection*vec4(primary.position,1.0);
        previousClip=camera.previousViewProjection*vec4(primary.previousPosition,1.0);
        depth=clamp(currentClip.z/currentClip.w,0.0,1.0);
        albedo=primary.color.rgb; normal=primary.normal;
        bias=1.0-primary.historyValid;
        if(dielectric(primary.material)) {
            uint currentMedium=(camera.flags&3u)==1u?WATER:0u;
            uint nextMedium=currentMedium==primary.material?0u:primary.material;
            specularAlbedo=vec3(fresnelDielectric(clamp(-dot(d,normal),0.0,1.0),ior(currentMedium),ior(nextMedium)));
            albedo=vec3(0.0); roughness=0.0;
            vec3 reflection=reflect(d,normal);
            trace(offsetOrigin(primary,reflection),reflection,65536.0);
            specularDistance=max(hit.distance,0.0);
        }
    } else {
        currentClip=camera.viewProjection*vec4(d,0.0);
        previousClip=camera.previousViewProjection*vec4(d,0.0);
    }
    vec2 motion=vec2(0.0);
    if(currentClip.w>0.00001 && previousClip.w>0.00001 && camera.outputSizeResetEnabled.z==0.0)
        motion=(previousClip.xy/previousClip.w-currentClip.xy/currentClip.w)*0.5*camera.jitterAndRenderSize.zw;
    else bias=1.0;
    imageStore(reconstructionDepth,pixel,vec4(depth));
    imageStore(reconstructionMotion,pixel,vec4(motion,0.0,0.0));
    imageStore(reconstructionDiffuse,pixel,vec4(albedo,1.0));
    imageStore(reconstructionSpecular,pixel,vec4(specularAlbedo,1.0));
    imageStore(reconstructionNormalRoughness,pixel,vec4(normal,roughness));
    imageStore(reconstructionSpecularDistance,pixel,vec4(specularDistance));
    imageStore(reconstructionHistoryBias,pixel,vec4(bias));
    vec3 color=vec3(0.0);
    if(VIEW_MODE==0) {
        for(int sampleIndex=0;sampleIndex<SAMPLES_PER_PIXEL;sampleIndex++) {
            vec2 sampleUV=camera.outputSizeResetEnabled.w>0.5?p:
                (vec2(gl_LaunchIDEXT.xy)+vec2(randomFloat(),randomFloat()))/vec2(gl_LaunchSizeEXT.xy);
            vec3 ray=mix(mix(camera.corners[0],camera.corners[2],sampleUV.y),mix(camera.corners[1],camera.corners[3],sampleUV.y),sampleUV.x);
            color+=pathTrace(camera.inverseView[3].xyz,normalize(mat3(camera.inverseView)*ray),sunDirection);
        }
        color/=float(SAMPLES_PER_PIXEL);
    } else if(primary.distance>=0.0) {
        if(VIEW_MODE==1) color=primary.color.rgb;
        else if(VIEW_MODE==2) color=primary.normal*0.5+0.5;
        else if(VIEW_MODE==3) color=primary.material==WATER?vec3(0.0,0.3,1.0):primary.material==GLASS?vec3(0.0,1.0,1.0):length(emission(primary.material,primary.color.rgb))>0.0?vec3(1.0,0.2,0.0):vec3(0.15);
        else color=(primary.kind&1u)!=0u?vec3(1.0,0.2,0.05):vec3(0.12,0.25,0.15);
    }
    imageStore(reconstructionColor,pixel,vec4(max(color,vec3(0.0))*camera.radianceExposure.x,1.0));
}


