#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_nonuniform_qualifier : require
#define ENTITY 0
#include "/lib/geometry.glsl"
#include "/lib/coverage.glsl"
#include "/lib/visibility.glsl"
void main() {
    if(!visibleTriangleSide(twoSidedSurface(),gl_HitKindEXT==gl_HitKindBackFacingTriangleEXT,hit.visibilityFlags))
        ignoreIntersectionEXT;
    else {
        bool blend=alphaBlendSurface();
        bool cutout=alphaDiscardSurface();
        if(!blend&&!cutout) return;
        float alpha=sampleSurface().a;
        if(blend) {
            if(!covered(alpha,hit.coverageSeed,uint(gl_PrimitiveID),uint(gl_InstanceID))) ignoreIntersectionEXT;
        } else if(alpha<0.5) ignoreIntersectionEXT;
    }
}
