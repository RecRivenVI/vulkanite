-    float brlp_ex = pow(2.0, brlp_m*brlp_ach_d*tsn);
-    rgb *= brlp_ex;
-  }
-
-  // Purity Compress Low
-  if (ptl_enable == 1) rgb = vec3(odt_softplus(rgb.x, ptl_c), odt_softplus(rgb.y, ptl_m), odt_softplus(rgb.z, ptl_y));
- 
-  // Final tonescale adjustments
-  tsn *= ts_m2; // scale for inverse toe
-  tsn = odt_compress_toe_quadratic(tsn, tn_toe, 0);
-  tsn *= ts_dsc; // scale for display encoding
-  
-
-  return clamp(rgb*tsn,0.0,1.0);
-}
-
-#endif
