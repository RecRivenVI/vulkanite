-    VCmdBuff(VCommandPool pool, VkCommandBuffer buff) {
-        this.pool = pool;
-        this.buffer = buff;
-        this.transientResources = new HashSet<>();
-    }
-
-    //Enqueues the pool to be freed by the owning thread
