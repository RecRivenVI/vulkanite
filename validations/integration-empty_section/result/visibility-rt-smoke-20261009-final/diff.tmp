-    public final String name;
-    public final String raygen;
-    public final String[] raymiss;
-    public final RayHitSource[] rayhit;
-
-    public RaytracingShaderSource(String name, String raygen, String[] raymiss, RayHitSource... rayhit) {
-        this.name = name;
-        this.raygen = raygen;
