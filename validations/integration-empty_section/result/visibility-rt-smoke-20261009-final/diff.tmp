index 30d1aec..0000000
--- a/tools/reference/opendrt/OpenDRT.dctl
+++ /dev/null
@@ -1,1211 +0,0 @@
-#line 2 // Fix line numbers in resolve/logs/rollinglog.txt
-
-/* OpenDRT v1.1.0 -------------------------------------------------
-
-  Written by Jed Smith
-  https://github.com/jedypod/open-display-transform
