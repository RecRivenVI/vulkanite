-    public VGSemaphore createSharedBinarySemaphore() {
-        return Vulkanite.IS_WINDOWS?createSharedBinarySemaphoreWin32():createSharedBinarySemaphoreFd();
-    }
-
-    public VSemaphore createBinarySemaphore() {
-        try (var stack = stackPush()) {
